{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-claude-md-read.mjs\"",
            "timeout": 10,
            "statusMessage": "CLAUDE.md既読チェック中..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-new-rule-has-machine-check.mjs\"",
            "timeout": 10,
            "statusMessage": "新規ルールの機械検査チェック中..."
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-ask-preceded-by-research.mjs\"",
            "timeout": 10,
            "statusMessage": "調査履歴チェック中..."
          }
        ]
      }
    ]
  }
}
