# 受付スレッドにコメントが付いたときだけ、この PC の worker を1回動かす（10分おきなどの定期実行はしない）。
#
# 置く場所: 受付 Issue があるリポの .github/workflows/idea-pipeline-on-request.yml
# 前提: そのリポが private であること（self-hosted ランナーは、public リポで使うと誰でもこの PC でコードを動かせてしまう）。
#       この PC に self-hosted ランナーを入れて、ラベル idea-pipeline を付けておくこと（README「頼まれたときだけ動かす」参照）。
#
# 書き換える所: INBOX_ISSUE_NUMBER（受付 Issue の番号）と、worker.mjs の絶対パス。
name: idea-pipeline-on-request

on:
  issue_comment:
    types: [created]

# 同時に2つは動かさない。待っている間に増えたコメントは、次の1回がまとめて拾う。
concurrency:
  group: idea-pipeline
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  run:
    # 受付スレッドへのコメントで、worker 自身の返信（目印つき）ではないときだけ。
    # worker が書いた返信でまた起動して、空振りの周回が続くのを防ぐ。
    if: github.event.issue.number == INBOX_ISSUE_NUMBER && !contains(github.event.comment.body, '<!-- idea-pipeline:')
    runs-on: [self-hosted, idea-pipeline]
    timeout-minutes: 60
    steps:
      # コメントの本文などは、コマンドに埋め込まない（埋め込むと、コメントに書かれた文字がコマンドとして動く）。
      # worker は自分で GitHub からコメントを読み直し、許可された作者かどうかも自分で確かめる。
      - name: worker を1回動かす（PR のチェックが終わるまで待って、結果まで受付に書く）
        shell: cmd
        run: node "C:\path\to\web-ios-android\templates\idea-to-pr-local\worker.mjs" --once --settle
