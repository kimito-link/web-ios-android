{
  "repos": {
    "OWNER/REPO": {
      "path": "C:/path/to/local/clone/of/REPO",
      "installCommand": ["npm", "ci"],
      "gateCommand": ["npm", "test"]
    }
  },
  "allowedAuthors": ["YOUR-GITHUB-LOGIN"],
  "inboxes": [
    { "repo": "OWNER/INBOX_REPO", "issue": 1, "defaultTarget": "OWNER/REPO" }
  ],
  "ledgerPath": "C:/path/to/best-trust/data/repositories.json",
  "siteAliases": { "example.com": "OWNER/REPO" },
  "maxRunsPer24h": 5,
  "maxTurns": 40,
  "workTimeoutMinutes": 30,
  "maxChangedFiles": 50,
  "keepFailedWorktrees": true,
  "verifyGraceMinutes": 15,
  "stateDir": "C:/Users/YOU/.idea-pipeline"
}
