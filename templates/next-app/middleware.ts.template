// ============================================================================
// Clerk 認証の middleware。auth.provider === "clerk" のとき middleware.ts として配置。
// kimitolink-linktree の実運用版を金型化。
//
// ★★Next.js 16 以上では、このファイル名を `proxy.ts` に変える（2026-10-02、surechigai の
//   apps/web が Next 16.3 で「middleware file convention is deprecated. Please use proxy」の
//   警告を出したため改名して解消）。中身（clerkMiddleware の呼び出しと config.matcher）は
//   そのままでよい。proxy は Node.js ランタイム固定。この金型自体は Next 15 前提なので
//   ファイル名は middleware.ts のまま（Next 16 へ上げる時に改名）。
//
// ★ ストア審査の落とし穴（重要）:
//   スクショ自動撮影スクリプト（capture-appstore/play-screenshots.mjs）は
//   「未ログイン状態」でページを開いて撮る。認証必須ページしか無いと真っ白/リダイレクトで
//   撮影が失敗する。だから撮影対象の紹介ページ（/ や /store-preview 等）は必ず
//   public に入れておくこと。iOS/Play どちらの初回提出でもここで詰まりやすい。
//
// ★★プライマリドメイン以外（検証用デプロイ・*.vercel.app等）で動かすと404になる地雷
//   （2026-10-02、surechigai-romi.link の apps/web 移行で実機確認・修正済み）:
//   Clerkは本番以外のオリジンで動くとき、自前のフロントエンドAPIプロキシ経路
//   `/__clerk/npm/@clerk/clerk-js@6/dist/clerk.browser.js` 等からJSを読もうとする。
//   下のmatcherの静的アセット除外パターン`js(?!on)`は拡張子.jsのパスを全部除外するため、
//   この`__clerk`配下のパスもmiddlewareの対象から漏れ、404→MIMEエラーでClerkが
//   起動しない（「鍵が違う」「ドメインが未登録」と誤診しやすい）。
//   プライマリドメイン（例: kimito.link）で動かす限りは顕在化しない
//   （プロキシ経路を使わず直接 clerk.<primary> から読むため）ので、
//   検証用サブドメインや*.vercel.appで初めて踏む。
//
// ★★★続きの地雷とその訂正（2026-10-02、surechigai-romi.link の apps/web 移行で実機確認）:
//   一度 frontendApiProxy: { enabled: true } を追加して「解決した」としたが誤りだった。
//   この機能は「Clerkのカスタムドメインを使わず、Clerkのデフォルトフロントエンド
//   API(frontend-api.clerk.dev)への直接アクセスがブロックされる環境向け」の別機能——
//   有効にすると常にfrontend-api.clerk.devへ転送し、publishableKeyが指すカスタム
//   ドメイン(clerk.<primary>)は使われなくなる(window.Clerk.proxyUrlが勝手にセット
//   される)。カスタムフロントエンドAPIドメインを既に持つ構成では**追加しない**。
//
//   ★根本原因はClerk JS自身の自動判定: 本番URLが`*.vercel.app`で終わるとき、
//   Clerk JSはサーバー側の設定に関わらず自動でプロキシモード(/__clerk/経由)に入る
//   （公式Issue等で報告されている既知挙動）。つまり検証用の`*.vercel.app`単体ドメインは
//   この自動判定のせいで最初から正しく動かない構成であり、単体検証には使えない。
//   最終的な本番ドメイン（プライマリまたはカスタムサブドメイン、`.vercel.app`で
//   終わらないもの）経由でアクセスすれば自動判定に入らず、publishableKeyから直接
//   clerk.<primary>を使う——これが唯一の正しい検証方法。matcherの/__clerk/(.*)は
//   念のための保険として残すが、frontendApiProxyオプションは付けないこと。
// ============================================================================
import { clerkMiddleware, createRouteMatcher } from "@clerk/nextjs/server";

// 未ログインでもアクセスできる公開ルート。ここに無いパスは自動的に認証必須になる。
const isPublicRoute = createRouteMatcher([
  "/",
  "/sign-in(.*)",
  "/sign-up(.*)",
  "/logout(.*)",
  // 法務・料金など公開が要る静的ページ。
  "/terms(.*)",
  "/privacy(.*)",
  "/price(.*)",
  // ★ ストア審査スクショ撮影専用ページ（noindex 推奨・未ログインで撮る）。
  "/store-preview(.*)",
  "/demo(.*)",
  // クローラー/OG 画像が未ログインで叩くもの。
  "/robots.txt",
  "/sitemap.xml",
  "/opengraph-image(.*)",
  "/twitter-image(.*)",
  // 第三者が未ログインで踏む公開 API があればここに追加（例: OG 画像生成 /api/og）。
  "/api/og(.*)",
]);

export default clerkMiddleware(async (auth, req) => {
  if (!isPublicRoute(req)) {
    await auth.protect();
  }
});

export const config = {
  matcher: [
    // 静的アセット・_next を除く全ルート。
    "/((?!_next|[^?]*\\.(?:html?|css|js(?!on)|jpe?g|webp|png|gif|svg|ttf|woff2?|ico|csv|docx?|xlsx?|zip|webmanifest)).*)",
    "/(api|trpc)(.*)",
  ],
};
