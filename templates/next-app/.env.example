# ============================================================================
# next-app の環境変数サンプル。.env.local にコピーして実値を入れる（.env.local は
# 必ず .gitignore する）。Clerk を使わない場合は CLERK_* 行を削除してよい。
# setup-clerk-x-oauth.mjs --write-env でも生成できる。
# ============================================================================

# ── Clerk（auth.provider = clerk のとき必須）──────────────────────────────
# ダッシュボード → API Keys から取得。pk_test_ / sk_test_ は開発、pk_live_ / sk_live_ は本番。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# サインイン/アップの URL とリダイレクト先（末尾スラッシュは trailingSlash:true に合わせる）。
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up/
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard/
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard/

# keyless 開発モードを無効化（本番前提の明示）。
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true

# ── アプリ本体 ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://{{productionDomain}}
