# 署名用キーストアの設定（金型）。出どころ: Exosome/android-twa/keystore.properties.example
# このファイルを android-twa/keystore.properties にコピーして値を設定するか、
# create-android-keystore.ps1 が自動生成します（鍵と同時に書き出す）。
#
# 保存形式: UTF-8（BOM なし必須）。BOM 付きだと Gradle の signReleaseBundle が NPE になります。
# このファイル自体（.example）と keystore.properties / *.jks は .gitignore に入れること（鍵を commit しない）。

storePassword=<ストアパスワード（6文字以上）>
keyPassword=<鍵パスワード（store と同じで可）>
keyAlias=upload
