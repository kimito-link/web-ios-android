/**
 * app/(auth)/layout.tsx — 認証ルートの ClerkProvider 設定（金型）
 *
 * ★出典: kimitolink-linktree/app/(auth)/layout.tsx（本番稼働中）
 * ★ブランド依存は auth-brand.config.ts に外出し済み。
 *
 * ★ここが「共通アカウント（1ログインで全サービス）」の心臓部。
 *   allowedRedirectOrigins に無いサービスへは**沈黙して戻れない**（エラーも出ない）。
 */
import { ClerkProvider } from "@clerk/nextjs";
import { authBrandConfig } from "@/lib/auth-brand.config";
// ★localization（日本語見出し）と appearance（X 主役化）。出さないと Clerk 既定の英語見出し
//   （"Sign in to ◯◯"）と素の見た目になる。要 `@clerk/localizations`（pnpm add）。
import { brandJaJP } from "@/lib/clerk-localization";
import { brandClerkAppearance } from "@/lib/clerk-appearance";
// ★<html data-auth> の裏取り（ちらつきゼロ契約、../README.md）。ペイント前の先出しは
//   app/layout.tsx の <head> スニペット（lib/auth-mode-head-script.ts）が行う。
import { AuthModeSync } from "@/components/AuthModeSync";

const {
  afterAuthPath,
  signInPath,
  signUpPath,
  afterSignOutPath,
  allowedRedirectOrigins,
  developmentRedirectOrigins,
  clerkFrontendApiDomain,
  forceFrontendApiDomain,
} = authBrandConfig;

export default function AuthLayout({
  children,
}: Readonly<{ children: React.ReactNode }>) {
  return (
    <ClerkProvider
      // 方式A: 共通アカウント（親ドメインで __client cookie を共有）。
      // ★サブドメイン方式なら satellite 設定は不要かつ有害
      //   （isSatellite:true は verified でない限り /v1/client/sync が落ちる）。
      //
      // ★domain の明示は「別 Vercel プロジェクトへ外部 rewrite する構成」だけ（既定は付けない）。
      //   本番URLが *.vercel.app だと Clerk JS が自前プロキシへ自動で入り「400 Invalid host」。
      //   domain を渡すと自動判定がサーバー・クライアント両方で止まる。環境変数
      //   CLERK_DISABLE_AUTO_PROXY は NEXT_PUBLIC_ 接頭辞が無くブラウザに届かず効かない。
      //   正本KB: ai-hub/kb/clerk-vercel-custom-domain-auto-proxy-trap.md
      {...(forceFrontendApiDomain ? { domain: clerkFrontendApiDomain } : {})}
      allowedRedirectOrigins={
        process.env.NODE_ENV === "development"
          ? [...developmentRedirectOrigins, ...allowedRedirectOrigins]
          : allowedRedirectOrigins
      }
      allowedRedirectProtocols={["http:", "https:"]}
      signInUrl={signInPath}
      signUpUrl={signUpPath}
      // ★FORCE: どの入口から来ても着地先へ送る（最優先）。
      //   env(NEXT_PUBLIC_CLERK_SIGN_IN/UP_FORCE_REDIRECT_URL)にも設定するが、
      //   コードでも明示して env 欠落時の迷子を二重に防ぐ（Clerk公式推奨）。
      //   ★注意: FORCE は redirect_url より強い。姉妹サービスから送客されたとき
      //   「戻れない」事故になるので、各サービスが**自分の** sign-in を持つ設計にする
      //   （kimito.link/sign-in へ送客しない。exosome が 2026-09-16 に実測して確定）。
      signInForceRedirectUrl={afterAuthPath}
      signUpForceRedirectUrl={afterAuthPath}
      // FALLBACK は FORCE が効かない経路の保険（既定の '/' 着地を防ぐ）。
      signInFallbackRedirectUrl={afterAuthPath}
      signUpFallbackRedirectUrl={afterAuthPath}
      afterSignOutUrl={afterSignOutPath}
      localization={brandJaJP}
      appearance={brandClerkAppearance}
      // ※ clerk-js / @clerk/ui の実バージョン固定（タグ @6/@1 → 実バージョンの 307 往復を無くす）は
      //   next.config.ts の env（NEXT_PUBLIC_CLERK_JS_VERSION / NEXT_PUBLIC_CLERK_UI_VERSION）で渡す。
      //   値と更新手順は lib/clerk-script-versions.ts。@clerk/nextjs 7.x の公開 prop には無く env 経路のみ。
    >
      {/* <html data-auth> の裏取り: Clerk 読込後に本当のセッション状態で上書き（描画は無し）。 */}
      <AuthModeSync />
      <div id="main-content" tabIndex={-1}>
        {children}
      </div>
    </ClerkProvider>
  );
}
