/**
 * lib/auth-mode-head-script.test.ts — `<head>` に埋める実物のスクリプト文字列を実行して判定を固定する契約テスト（金型）。
 *
 * ★出典: kimitolink-linktree/lib/auth-mode-head-script.test.ts（2026-10-05 PR #381）に
 *   自インスタンス判定（data-auth-cookie-suffix）と接尾辞計算の突き合わせを足したもの。
 * 正本の型（Vanilla 版）: web-ios-android/templates/web/auth-mode/auth-mode-cookie-parsing.test.mjs.example
 * （あちらは正規表現を手で複製して検査し、ここでは本番に出る文字列自体を jsdom で評価する）。
 *
 * 置き場: lib/auth-mode-head-script.test.ts（vitest, environment: jsdom）
 */
import { readFileSync } from "node:fs";
import { afterEach, describe, expect, it } from "vitest";
import {
  AUTH_MODE_HEAD_SNIPPET_PATH,
  computeClerkCookieSuffix,
  extractInlineScript,
  getAuthCookieSuffix,
  getAuthModeHeadScript,
} from "./auth-mode-head-script";

function setCookies(cookies: string[]) {
  for (const c of cookies) document.cookie = `${c}; path=/`;
}

function clearCookies() {
  for (const raw of document.cookie.split(";")) {
    const name = raw.split("=")[0]?.trim();
    if (name) document.cookie = `${name}=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT`;
  }
}

function runHeadScript(suffix?: string): string | null {
  document.documentElement.removeAttribute("data-auth");
  if (suffix == null) document.documentElement.removeAttribute("data-auth-cookie-suffix");
  else document.documentElement.setAttribute("data-auth-cookie-suffix", suffix);
  // 本番の <script> と同じく、グローバルスコープで即時実行される。
  new Function(getAuthModeHeadScript())();
  return document.documentElement.getAttribute("data-auth");
}

describe("auth-mode head snippet（キット金型のコピー）", () => {
  it("金型コピーが存在し、<script> の中身を取り出せる", () => {
    const html = readFileSync(AUTH_MODE_HEAD_SNIPPET_PATH, "utf8");
    expect(html).toContain("<script>");
    expect(extractInlineScript(html)).toBe(getAuthModeHeadScript());
  });

  it("金型と同じ exec-loop（グローバルフラグ）で全件走査している（String#match 単体に戻っていない）", () => {
    const script = getAuthModeHeadScript();
    expect(script).toMatch(/__client_uat\[\^=\]\*=\(\[\^;\]\*\)\/g/);
    expect(script).toMatch(/re\.exec\(document\.cookie\)/);
    expect(script).toMatch(/data-auth-cookie-suffix/);
    expect(script).toMatch(/setAttribute\('data-auth'/);
  });

  it("<script> が無い HTML は例外（黙って空文字を埋めない）", () => {
    expect(() => extractInlineScript("<!-- nothing -->")).toThrow();
    expect(() => extractInlineScript("<script>   </script>")).toThrow();
  });
});

describe("ペイント前の data-auth 判定（実物の文字列を実行・従来判定）", () => {
  afterEach(() => {
    clearCookies();
    document.documentElement.removeAttribute("data-auth");
    document.documentElement.removeAttribute("data-auth-cookie-suffix");
  });

  it("cookie が無ければ guest", () => {
    expect(document.cookie).toBe("");
    expect(runHeadScript()).toBe("guest");
  });

  it("__client_uat=0 のみ（未ログイン）は guest", () => {
    setCookies(["__client_uat=0"]);
    expect(runHeadScript()).toBe("guest");
  });

  it("__client_uat が 0 以外なら member", () => {
    setCookies(["__client_uat=1234567890"]);
    expect(runHeadScript()).toBe("member");
  });

  it("★実損の再現: 接尾辞付き(値0)が先・接尾辞無し(値あり)が後でも member", () => {
    // 本番で観測した並び（surechigai-romi.link / yukkuri-exosome.link, 2026-09-29）
    setCookies(["__client_uat_ZGVu8CMk=0", "__client_uat=1234567890"]);
    expect(document.cookie).toContain("__client_uat_ZGVu8CMk=0");
    expect(runHeadScript()).toBe("member");
  });

  it("接尾辞付き・接尾辞無し、両方とも 0 なら guest", () => {
    setCookies(["__client_uat_ZGVu8CMk=0", "__client_uat=0"]);
    expect(runHeadScript()).toBe("guest");
  });

  it("接尾辞付きのみが 0 以外でも member", () => {
    setCookies(["__client_uat_ZGVu8CMk=9876543210"]);
    expect(runHeadScript()).toBe("member");
  });

  it("無関係な cookie が混在していても判定できる", () => {
    setCookies(["theme=dark", "__client_uat_ZGVu8CMk=0", "__client_uat=1234567890", "lang=ja"]);
    expect(runHeadScript()).toBe("member");
  });

  it("__client_uat という文字列を含むだけの無関係な cookie には反応しない", () => {
    setCookies(["some_other_cookie=1234567890"]);
    expect(runHeadScript()).toBe("guest");
  });
});

describe("ペイント前の data-auth 判定（自インスタンス判定: data-auth-cookie-suffix あり）", () => {
  afterEach(() => {
    clearCookies();
    document.documentElement.removeAttribute("data-auth");
    document.documentElement.removeAttribute("data-auth-cookie-suffix");
  });

  it("★姉妹だけにログイン中（自分の接尾辞は 0・接尾辞無しは値あり）は guest（従来判定だと member）", () => {
    setCookies(["__client_uat_ZGVu8CMk=0", "__client_uat=1234567890"]);
    expect(runHeadScript("ZGVu8CMk")).toBe("guest");
    expect(runHeadScript()).toBe("member");
  });

  it("自分の接尾辞付きが 0 以外なら member（接尾辞無しが 0 でも）", () => {
    setCookies(["__client_uat=0", "__client_uat_ZGVu8CMk=1234567890"]);
    expect(runHeadScript("ZGVu8CMk")).toBe("member");
  });

  it("自分の接尾辞付き cookie が無ければ guest（接尾辞無しの値は見ない）", () => {
    setCookies(["__client_uat=1234567890", "__client_uat_other1=1234567890"]);
    expect(runHeadScript("ZGVu8CMk")).toBe("guest");
  });

  it("接尾辞が前方一致するだけの別 cookie には反応しない", () => {
    setCookies(["__client_uat_ZGVu8CMkXX=1234567890"]);
    expect(runHeadScript("ZGVu8CMk")).toBe("guest");
  });

  it("形式に合わない接尾辞（空・記号）は無視して従来判定に落ちる", () => {
    setCookies(["__client_uat_ZGVu8CMk=0", "__client_uat=1234567890"]);
    expect(runHeadScript("")).toBe("member");
    expect(runHeadScript("a.b")).toBe("member");
  });
});

describe("接尾辞の計算（Clerk 公式 SDK @clerk/shared getCookieSuffix と同一）", () => {
  it("base64url(sha-1(pk)) の先頭 8 文字・URL-safe（[A-Za-z0-9_-]）", () => {
    const s = computeClerkCookieSuffix("pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk");
    expect(s).toMatch(/^[A-Za-z0-9_-]{8}$/);
    // 同じ鍵なら同じ値（決定的）
    expect(computeClerkCookieSuffix("pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk")).toBe(s);
    // 鍵が違えば別の値
    expect(computeClerkCookieSuffix("pk_live_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk")).not.toBe(s);
  });

  it("鍵が未設定なら undefined（属性を付けず従来判定に落ちる）", () => {
    expect(getAuthCookieSuffix(undefined)).toBeUndefined();
    expect(getAuthCookieSuffix("")).toBeUndefined();
    expect(getAuthCookieSuffix("pk_test_abc")).toBe(computeClerkCookieSuffix("pk_test_abc"));
  });

  it("インストール済み @clerk/shared の getCookieSuffix と同じ値になる（解決できる環境のみ）", async () => {
    // @clerk/shared は @clerk/nextjs の間接依存。厳格なパッケージ解決では見えないことがあるので、
    // 見えないときは「測れなかった」として skip する（緑扱いにしない＝ログに出る）。
    type SharedKeys = { getCookieSuffix?: (pk: string) => Promise<string> };
    let mod: SharedKeys | null = null;
    try {
      // 指定子を変数にして、型解決・バンドラの静的解析の対象外にする（無い環境でも型エラーにしない）
      const specifier = "@clerk/shared/keys";
      mod = (await import(/* @vite-ignore */ specifier)) as SharedKeys;
    } catch {
      mod = null;
    }
    if (!mod?.getCookieSuffix) {
      console.warn("[auth-mode-head-script.test] @clerk/shared/keys を解決できず、公式実装との突き合わせを skip");
      return;
    }
    for (const pk of ["pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk", "pk_live_Y2xlcmsua2ltaXRvLmxpbmsk", "x"]) {
      expect(computeClerkCookieSuffix(pk)).toBe(await mod.getCookieSuffix(pk));
    }
  });
});
