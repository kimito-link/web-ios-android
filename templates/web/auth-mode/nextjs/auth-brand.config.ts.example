/**
 * 認証金型のブランド設定（Next.js + Clerk 版）
 *
 * ★この1ファイルだけを自プロジェクト用に書き換える。
 *   他の *.tsx.example はこの設定を読むので、原則そのままコピーしてよい。
 *
 * 出典: kimitolink-linktree（Next.js 16 + @clerk/nextjs 7 + App Router）。
 *   2026-10-01 に実機でコンソールエラー0・ちらつき無しを確認した実装を金型化したもの。
 *   正本KB: ai-generic-rules/docs/policies/CLERK_X_LOGIN_PLAYBOOK.md
 */

export type AuthBrandConfig = {
  /** 認証後の着地先。FORCE/FALLBACK 両方に使う（末尾スラッシュ込みで書く）。 */
  afterAuthPath: string;
  /** サインイン／サインアップのルート（末尾スラッシュ込み）。 */
  signInPath: string;
  signUpPath: string;
  /** サインアウト後の着地先。 */
  afterSignOutPath: string;

  /**
   * ★共通アカウントで「ログイン後に戻ってよい」オリジン。
   *   ここに無いサービスへは**沈黙して戻れない**（エラーも出ない）。
   *   サブドメイン方式なら cookie 共有で動く「はず」だが、
   *   それは未検証の理論なので明示列挙する（kimito が 2026-08-28 に明示化した判断）。
   */
  allowedRedirectOrigins: string[];
  /** 開発時のみ追加で許可するオリジン。 */
  developmentRedirectOrigins: string[];

  /** Clerk の FAPI ドメイン（preconnect に使う）。例: clerk.example.com */
  clerkFrontendApiDomain: string;

  /**
   * ★ClerkProvider に domain を明示するか。既定 false。
   *   true にすべきなのは「別の Vercel プロジェクトへ外部 rewrite で段階移行（strangler）する
   *   構成」で、この Next.js プロジェクトにカスタムドメインを割り当てていないとき。
   *   Clerk JS は本番URLが *.vercel.app だと自前プロキシ経路へ自動で入り「400 Invalid host」で
   *   ログイン画面が出ない。環境変数 CLERK_DISABLE_AUTO_PROXY はクライアント側で効かない。
   *   詳細: ai-hub/kb/clerk-vercel-custom-domain-auto-proxy-trap.md
   *   ★自プロジェクトにカスタムドメインを直接割り当てる通常構成では false のまま。
   */
  forceFrontendApiDomain: boolean;

  /** サービス名。Clerk 見出し（localization）に使う。例: "すれ違ひ通信" */
  serviceName: string;

  /**
   * サインイン画面の左カラム（サービス紹介）。AuthPageShell の intro に差し込む。
   * ★未設定（null）だと Clerk カードだけが中央にぽつんと出て「寂しい」画面になる
   *   （surechigai が 2026-10-02 に実際に指摘された）。出すのを既定にする。
   */
  intro: {
    /** 吹き出し（マスコットの上）。 */
    greeting: string;
    /** マスコット画像（public/ に置いたパス）。空配列なら描画しない。 */
    mascots: { src: string; name: string }[];
    /** サービス名の小見出し・見出し・説明文。 */
    eyebrow: string;
    headline: string;
    lead: string;
    /** 「ログイン後にできること」の箇条書き。 */
    features: string[];
  } | null;

  /**
   * ワンタップ遷移中のフルスクリーン表示。
   * ★画像を出さないなら image を null にする（金型は画像なしでも動く）。
   */
  autoAdvance: {
    /** 待機画面に出すキャラ/ロゴ画像。null なら画像を描画しない。 */
    image: { src: string; alt: string; width: number; height: number } | null;
    /** 背景色の Tailwind クラス（例: "bg-blue-900"）。 */
    backgroundClass: string;
    /** プログレスバーの色クラス（例: "bg-orange-500"）。 */
    accentClass: string;
    /** 見出し・補足文（自サービスの言葉に書き換える）。 */
    headline: string;
    subline: string;
    /** X の Sensitive permissions 警告への先出し案内。不要なら null。 */
    sensitiveNotice: string | null;
  };

  /**
   * Clerk カードと同寸のプレースホルダ（components/ClerkMountFallback.tsx）の材料。
   * ★ちらつきゼロ契約（../README.md）: 置き換わっても下の要素が動かないよう、本番と同じ構成を写す。
   */
  clerkCard: {
    /** カード左上のロゴ。clerk-appearance.ts の LOGO_PATH と同じ画像（実際に配信されているパス） */
    logoSrc: string;
    /**
     * 本番 Clerk Dashboard のソーシャルプロバイダ（表示順）。hero は主役ボタン（黒地、appearance の heroButton）。
     * ★Dashboard で増減したらここも合わせる（数が違うとボタン 1 個ぶん 58px ずつ縦ずれが戻る）。
     */
    providers: { key: string; title: string; hero: boolean }[];
  };

  /**
   * 未ログイン向け注意書き（components/AuthBrowserSessionNotice.tsx）。Clerk カードの直上に出す。
   * null なら出さない。★サーバーで最初から描き、CSS（.guest-only）で出し分ける（後から挿入しない）。
   */
  browserSessionNotice: { title: string; body: string } | null;
};

/**
 * ★ここから下を自プロジェクト用に書き換える。
 *   下記は kimito.link の実値（動作実績あり）をそのまま例示している。
 */
export const authBrandConfig: AuthBrandConfig = {
  afterAuthPath: "/dashboard/",
  signInPath: "/sign-in/",
  signUpPath: "/sign-up/",
  afterSignOutPath: "/logout/success/",

  allowedRedirectOrigins: [
    // 共通アカウントを共有する姉妹サービス（サブドメイン方式）
    "https://surechigai.kimito.link",
    "https://doin.kimito.link",
    "https://voice.kimito.link",
    // 旧・別ドメイン（移行期のため残す。廃止が確定したら外す）
    "https://surechigai-romi.link",
    "https://doin-challenge.com",
  ],
  developmentRedirectOrigins: ["http://127.0.0.1:3000", "http://localhost:3000"],

  clerkFrontendApiDomain: "clerk.kimito.link",
  forceFrontendApiDomain: false,

  serviceName: "kimito.link",
  intro: {
    greeting: "おかえり〜！待ってたよ",
    mascots: [
      { src: "/chara/link.png", name: "ゆっくりリンク" },
      { src: "/chara/konta.png", name: "こん太" },
      { src: "/chara/tanunee.png", name: "たぬ姉" },
    ],
    eyebrow: "kimito.link（キミトリンク）",
    headline: "X のプロフィールに貼る、公式のリンクまとめページ",
    lead: "ログインは X（旧 Twitter）のアカウントだけ。新しいパスワードはいりません。",
    features: [
      "公開ページにリンク一覧を表示",
      "リンクの追加・並べ替え・非表示をダッシュボードで編集",
    ],
  },

  autoAdvance: {
    image: {
      src: "/images/yukkuri/link-normal.png",
      alt: "りんく",
      width: 160,
      height: 160,
    },
    backgroundClass: "bg-kimito-blue",
    accentClass: "bg-kimito-orange",
    headline: "Xの画面へ進んでいます…",
    subline: "いまブラウザの X アカウントで入ります。",
    sensitiveNotice:
      "Sensitive permissions が出たら I trust this app にチェックして許可してください。",
  },

  clerkCard: {
    logoSrc: "/pwa-icon-192.png",
    // kimito.link 本番の構成（X / Apple / Google の 3 つ、2026-10-05 実測）。X が先頭なのは appearance の order:-1 と同じ
    providers: [
      { key: "x", title: "X / Twitter", hero: true },
      { key: "apple", title: "Apple", hero: false },
      { key: "google", title: "Google", hero: false },
    ],
  },

  browserSessionNotice: {
    title: "いまブラウザの X アカウントで入ります",
    body: "別アカで入りたいときは、先に X で切り替えるか、シークレット（プライベート）ウィンドウで開き直してください。",
  },
};
