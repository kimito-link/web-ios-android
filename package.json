{
  "name": "web-ios-android",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "verify": "node scripts/verify-all.mjs",
    "verify:selftest": "node scripts/verify-all.mjs --selftest",
    "zip:cws": "node scripts/chrome/build-zip-node.mjs",
    "publish:cws": "node scripts/chrome/build-zip-node.mjs && node scripts/chrome/publish-cws-node.mjs",
    "publish:cws:check": "node scripts/chrome/publish-cws-node.mjs --check",
    "publish:cws:upload": "node scripts/chrome/build-zip-node.mjs && node scripts/chrome/publish-cws-node.mjs --upload-only",
    "lint:docs": "node scripts/verify-doc-impl-coverage.mjs",
    "check:instrument-drift": "node _docs/instruments/check-drift.mjs",
    "check:instrument-drift:selftest": "node _docs/instruments/check-drift.mjs --selftest",
    "diagnostics": "node templates/diagnostics/run.mjs .",
    "improvement": "node scripts/check-improvement.mjs",
    "improvement:record": "node scripts/record-improvement.mjs --auto",
    "improvement:submission": "node scripts/check-improvement.mjs --submission",
    "check:improvement:selftest": "node scripts/check-improvement.mjs --selftest",
    "check:ran": "node scripts/check-instrument-ran.mjs --check",
    "check:ran:selftest": "node scripts/check-instrument-ran.mjs --selftest",
    "check:improvement": "node scripts/check-improvement.mjs --check && node scripts/check-instrument-ran.mjs --stamp improvement",
    "context": "node templates/scripts/context-engine.mjs --write .instrument-context.md .",
    "context:check": "node templates/scripts/context-engine.mjs --check .",
    "context:selftest": "node templates/scripts/context-engine.mjs --selftest",
    "context:record": "node templates/scripts/context-engine.mjs --record .",
    "instrument": "node templates/scripts/run-instruments.mjs --deep --report .instrument-report.json .",
    "instrument:site": "node templates/scripts/run-instruments.mjs --deep --security-url https://kimito-skill.link --report .instrument-report.json .",
    "instrument:selftest": "node templates/scripts/run-instruments.mjs --selftest",
    "security:score": "node templates/scripts/verify-security-score.mjs --url https://kimito-skill.link",
    "security:score:selftest": "node templates/scripts/verify-security-score.mjs --selftest",
    "responsive:check": "node templates/scripts/verify-responsive-design.mjs site",
    "responsive:check:selftest": "node templates/scripts/verify-responsive-design.mjs --selftest",
    "claims:provenance": "node scripts/verify-numeric-claims-provenance.mjs",
    "claims:provenance:selftest": "node scripts/verify-numeric-claims-provenance.mjs --selftest",
    "config:schema": "node templates/scripts/verify-app-config-schema.mjs",
    "config:schema:selftest": "node templates/scripts/verify-app-config-schema.mjs --selftest",
    "assetlinks:check": "node templates/scripts/verify-assetlinks-published.mjs",
    "assetlinks:check:selftest": "node templates/scripts/verify-assetlinks-published.mjs --selftest",
    "links:external": "node templates/scripts/verify-external-links.mjs site",
    "links:external:selftest": "node templates/scripts/verify-external-links.mjs --selftest",
    "splash:check": "node templates/scripts/check-splash-config.mjs",
    "splash:selftest": "node templates/scripts/check-splash-config.mjs --selftest && node templates/scripts/check-splash-safe-circle.mjs --selftest && node templates/scripts/check-splash-template-drift.mjs --selftest",
    "shindan": "node templates/scripts/generate-shindan-version.mjs --measure --root . --out site/check-shindan-version --base-url https://kimito-skill.link --name web-ios-android",
    "shindan:update": "node templates/scripts/generate-shindan-version.mjs --root . --out site/check-shindan-version --base-url https://kimito-skill.link --name web-ios-android",
    "hub:page": "node scripts/generate-hub-dashboard.mjs --root . --out site/hub",
    "hub:page:selftest": "node scripts/generate-hub-dashboard.mjs --selftest",
    "check:hub-freshness": "node scripts/check-hub-page-freshness.mjs --root . --data site/hub/hub-data.json",
    "check:hub-freshness:selftest": "node scripts/check-hub-page-freshness.mjs --selftest",
    "deploy:site": "npm run hub:page && npm run shindan:update && node templates/scripts/deploy-cloudflare-pages.mjs --dir site",
    "check:instrument-drift:coverage": "node _docs/instruments/check-drift-coverage.mjs",
    "check:instrument-drift:coverage:selftest": "node _docs/instruments/check-drift-coverage.mjs --selftest",
    "check:runner-registers-all": "node templates/diagnostics/check-runner-registers-all.mjs .",
    "check:runner-registers-all:selftest": "node templates/diagnostics/check-runner-registers-all.mjs --selftest"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "linkinator": "^8.0.4",
    "sharp": "^0.34.5"
  }
}
