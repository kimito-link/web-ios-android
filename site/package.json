{
  "name": "web-ios-android-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:pages": "node -e \"const fs=require('fs'),path=require('path');const skip=new Set(['dist','package.json','vercel.json','wrangler.toml']);fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist',{recursive:true});for(const e of fs.readdirSync('.'))if(!skip.has(e))fs.cpSync(e,path.join('dist',e),{recursive:true});\""
  }
}
